# ==========================================
# FITPRO SPORTS SOLUTIONS — ENVIRONMENT CONFIG
# Note: Never commit .env or secret values to version control.
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL via Prisma)
# Replace with your local PostgreSQL or Supabase/Neon connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitpro_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fitpro_db?schema=public"

# Authentication & Session Secrets
# Generate a secure 32+ character key with `openssl rand -base64 32`
AUTH_SECRET="your-super-secret-auth-key-change-in-production"

# OTP Provider Configuration
# Supported providers: MOCK (for local development/testing), MSG91, FIREBASE
OTP_PROVIDER="MOCK"

# MSG91 Credentials (if OTP_PROVIDER="MSG91")
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="FITPRO"

# Firebase Credentials (if OTP_PROVIDER="FIREBASE")
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Razorpay Payment Gateway Credentials
# Test mode keys start with rzp_test_
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Public Company Contact (matching /docs/content.md)
NEXT_PUBLIC_COMPANY_NAME="FITPRO SPORTS SOLUTIONS"
NEXT_PUBLIC_CONTACT_EMAIL="fitpro.sportssolutions@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE="9392201344"
